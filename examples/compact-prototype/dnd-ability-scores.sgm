# Prototype .sgm translation of samples/dnd-ability-scores.xml -- see
# the compact-format design notes' "Sample conversion exercise" section.

dataset.root = SixStats
dataset.columns = "str, dex, con, int, wis, cha"

Die = Uniform(1, 7)
D6 = ToInteger(Die, mode="floor")
ThreeDice = Redimension(D6, dimension=3)
Sum = Calculate(ThreeDice, expression="y[0] = x[0] + x[1] + x[2]")
KeepSum = Arrange(Sum, columns=(0))
SixStats = Redimension(KeepSum, dimension=6)
