<?xml version="1.0" encoding="UTF-8"?>
<!-- Simulation 101, lesson 4.4, incidents (PRO: Perturb).  One row = one request.
     Column 0  latency in ms.   Column 1  incident flag: 0 while healthy, 1 during an incident (the model reports its own state).
       Healthy   Lognormal, median 30 ms (mu = ln 30 = 3.4011973816621555), sigma 0.3
       Degraded  Lognormal, median 200 ms (mu = ln 200 = 5.298317366548036), sigma 0.5
       Gap       healthy requests between incidents: Exponential with mean 5,000 (lambda 0.0002), rounded UP to a whole number with ToInteger
       Length    requests per incident: Geometric(p = 0.002), mean 500
     Perturb(repeat, synchronous): during an incident the degraded value REPLACES the healthy one.  The wait counts healthy requests and
     starts again when an incident ends.  synchronous="true" keeps the healthy stream advancing during an incident, so it picks up where
     it would have been.  Perturb outputs only the active branch, so each branch carries its own flag column (a Constant): that is how
     the model says whether a request is inside an incident.
     Expected share of requests inside an incident about 500 / (5,000.5 + 500) = 9.09%; incidents per 1,000,000 requests about 181.8.
     A day of 1,000,000 requests: run Grind with a count of 1000000 on this file.     10 nodes. -->
<dataset columns="latency, inIncident" seed="404">
  <root node="Latency"/>
  <nodes>
    <Lognormal name="HealthyLatency" mu="3.4011973816621555" sigma="0.3" synchronous="true"/>
    <Lognormal name="DegradedLatency" mu="5.298317366548036" sigma="0.5" synchronous="true"/>
    <Constant name="Up" value="0" type="double"/>
    <Constant name="Down" value="1" type="double"/>
    <Append name="Healthy">
      <input name="HealthyLatency"/>
      <input name="Up"/>
    </Append>
    <Append name="Degraded">
      <input name="DegradedLatency"/>
      <input name="Down"/>
    </Append>
    <Exponential name="GapRaw" lambda="0.0002"/>
    <ToInteger name="Gap" mode="ceiling">
      <input name="GapRaw"/>
    </ToInteger>
    <Geometric name="IncidentLength" p="0.002"/>
    <Perturb name="Latency" repeat="true" synchronous="true">
      <input name="Healthy" role="normal"/>
      <input name="Degraded" role="disturbance"/>
      <input name="Gap" role="wait"/>
      <input name="IncidentLength" role="duration"/>
    </Perturb>
  </nodes>
</dataset>
