<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sample SpiceGrinder model: US Employer Identification Number via the EIN generator.

  The 2-digit prefix is drawn uniformly from the real set of prefixes the IRS currently
  assigns — all of 01-99 excluding the real, specifically documented set the IRS states are
  "invalid for input and no longer being assigned" (00, 07, 08, 09, 17, 18, 19, 28, 29, 49,
  69, 70, 78, 79, 89, 96, 97). The 7-digit serial is drawn uniformly at random.

  This means a generated EIN can, in principle, coincide with a real, currently-registered
  business's EIN — but it carries zero connection to any real organization or PII.
  No fictionalOnly toggle: the IRS's invalid-prefix list documents prefixes no longer
  assigned to new applicants, not an officially reserved "guaranteed safe for testing" block.

  Output: one Observation of [ein] per pull, rendered as "12-3456789".
-->
<dataset>
	<root node="Employer"/>
	<nodes>
		<EIN name="Employer"/>
	</nodes>
</dataset>
