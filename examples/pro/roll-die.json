{
  "dataset": {
    "root": "Roll",
    "columns": "roll",
    "declarations": [
      {"name": "d", "value": "6"}
    ],
    "nodes": [
      {
        "type": "Uniform",
        "name": "Base",
        "attributes": {"min": "0", "max": "$d"}
      },
      {
        "type": "Calculate",
