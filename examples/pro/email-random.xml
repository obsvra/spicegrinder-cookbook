<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sample SpiceGrinder model: random-word email address via the Email generator
  (nameBased="false").

  No name input needed at all — the local part is a random common English word plus a
  random number (e.g. "garden32"), drawn from email_words.txt (5,432 common English words
  from SCOWL, filtered for length and appropriateness — see that file's own header comment
  for the source and filtering). The "domain" input is the same real
  weighted email-provider list used by samples/pro/email.xml.

  Same collision-without-PII disclosure as the name-based mode: a generated address can in
  principle coincide with a real, in-use inbox, but carries no tie to any real person's
  data — if anything, less so than the name-based mode, since there's no name involved at all.

  Output: one Observation of [email] per pull, rendered as "local@domain".
-->
<dataset>
	<root node="ContactEmail"/>
	<nodes>
		<Email name="ContactEmail" nameBased="false">
			<input name="Domain" role="domain"/>
		</Email>

		<FlatFile name="Domain" file="samples/pro/email_domains_weighted.csv" mode="weighted"/>
	</nodes>
</dataset>
