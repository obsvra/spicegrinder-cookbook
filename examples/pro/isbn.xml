<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sample SpiceGrinder model: 13-digit ISBN via the ISBN generator.

  RegistrationGroup is a plain composed Input drawn from isbn_registration_groups.csv — real
  single-digit ISBN registration groups assigned by the International ISBN Agency (0/1 =
  English, 2 = French, 3 = German, 4 = Japan, 5 = former USSR, 7 = China). The real "978" EAN
  Bookland prefix is fixed (979 also exists in the real standard but is not modeled here). The
  remaining 8 digits (publisher + title code, combined — the real standard's variable-width
  boundary between them is not modeled, since no complete citable real publisher-range table
  was available) are drawn uniformly at random. The 13th digit is the real ISO 2108/EAN-13
  check digit (alternating weights 1/3, sum mod 10). Rendered as the bare 13-digit string, no
  hyphens. See ISBN.java's own javadoc for the full disclosure.

  This means a generated ISBN can, in principle, coincide with a real, currently-assigned
  ISBN — but it carries zero connection to any real book, publisher, or person. No
  fictionalOnly toggle: no standards body publishes an officially reserved "guaranteed safe"
  ISBN block.

  Output: one Observation of [isbn] per pull, rendered as the bare 13-digit string.
-->
<dataset>
	<root node="Book"/>
	<nodes>
		<ISBN name="Book">
			<input name="RegistrationGroup"/>
		</ISBN>

		<FlatFile name="RegistrationGroup" file="samples/pro/isbn_registration_groups.csv" mode="unweighted"/>
	</nodes>
</dataset>
