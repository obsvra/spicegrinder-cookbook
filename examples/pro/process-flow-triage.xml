<?xml version="1.0" encoding="UTF-8"?>
<!--
  ProcessFlow with entity attributes: an emergency department with triage priority, as one node (PRO: ProcessFlow).

  Patients arrive at a rate that follows the clock (clock in hours): 2 an hour overnight (23:00 to 07:00) and 5 an hour by day, about 96 a day. Each patient has a triage
  class from 1 (most urgent) to 5, drawn at arrival with shares 2, 14, 40, 35 and 9 percent and kept as the attribute "class" (the Categorical gives 0 to 4, and the
  Calculate adds 1). The department has five treatment places in one station. Treatment times are Gamma with shape 2 and a mean that depends on the class:
  2, 1.5, 1, 0.58 and 0.33 hours (120, 90, 60, 35 and 20 minutes). Waiting patients are called lowest class first, first come first served inside a class, and a
  treatment that has begun is never interrupted: priority="ED:class". The service time comes from the input for the patient's class: serviceBy="ED:class".
  The offered load is 4.4 busy places by day against 5, and 1.8 overnight.
  One row is one patient who has left (output="entities"). Output columns, 7 per row: 0 the clock time (hours) the patient left, 1 patient number, 2 hours in the
  department, 3 hours waiting for a treatment place, 4 hours in treatment, 5 visits (1), 6 the triage class.

  To run it:        grind with a count of 20000 on samples/pro/process-flow-triage.xml        (about 200 days)
  What to look for: the more urgent classes wait far less than the others. Measured over 600 days of this seed with the first 20 dropped, the mean wait in minutes
                    for classes 1 to 5 is 5.1, 6.6, 15.2, 56.3 and 101.0 (36.1 over all patients). The ordering is the point; the numbers move with the placeholders
                    (rates, shares, treatment times). Remove priority="ED:class" and every class waits alike: that is what first come first served costs the urgent ones.
-->
<dataset columns="exitTime, patient, sojourn, wait, service, visits, triageClass" seed="20261014">
  <root node="ED"/>
  <nodes>
    <Exponential name="Gap" lambda="1.0"/>
    <Categorical name="Mix" weights="2 14 40 35 9"/>
    <Calculate name="Class" expression="y[0] = x[0] + 1"><input name="Mix"/></Calculate>
    <Gamma name="T1" shape="2" scale="1.0"/>
    <Gamma name="T2" shape="2" scale="0.75"/>
    <Gamma name="T3" shape="2" scale="0.5"/>
    <Gamma name="T4" shape="2" scale="0.29166666666666669"/>
    <Gamma name="T5" shape="2" scale="0.16666666666666666"/>
    <ProcessFlow name="ED" stations="ED:5" output="entities" attributes="class" priority="ED:class" serviceBy="ED:class"
                 rate="0:2, 7:5, 23:2" ratePeriod="24">
      <input name="Gap" role="arrival"/>
      <input name="Class" role="entity"/>
      <input name="T1" role="service.ED@1"/>
      <input name="T2" role="service.ED@2"/>
      <input name="T3" role="service.ED@3"/>
      <input name="T4" role="service.ED@4"/>
      <input name="T5" role="service.ED@5"/>
    </ProcessFlow>
  </nodes>
</dataset>
