<!-- Simulation 101, lesson 4.1 (PRO). The same library, imported with two declared values overridden: median 33 ms, sigma 0.87.
     The library file is not changed. The analytic p99 is 33 * exp(2.3263 * 0.87) = 249.74 ms. One row = one request. -->
<dataset columns="latency" seed="402">
  <root node="Sys"/>
  <nodes>
    <Import name="Sys" file="latency-lib.xml" median="33" sigma="0.87"/>
  </nodes>
</dataset>
